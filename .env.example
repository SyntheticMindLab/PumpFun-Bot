# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_CHAT_ID=
TELEGRAM_TRADE_NAME=Zepto
TELEGRAM_PROFILE_URL=
TELEGRAM_CALLOUT_FOOTER=every fill called live — nothing cherry-picked

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
WALLET_PRIVATE_KEY_BASE58=

# PumpPortal
PUMPPORTAL_API_KEY=

# Runtime
MODE=CONFIRM
AUTO_LIVE=false
DATABASE_PATH=data/journal.db
RULES_PATH=config/rules.yaml
LOG_LEVEL=INFO

# Trading hard limits
MAX_TRADE_SOL=0.01
MAX_POSITION_SOL=0.03
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_SOL=0.03
MAX_SLIPPAGE_PCT=10
MAX_PRIORITY_FEE_SOL=0.0001

# Discovery / market data
MAX_WATCHED_TOKENS=20
RUGCHECK_ENABLED=true
RUGCHECK_BASE_URL=https://api.rugcheck.xyz
DEXSCREENER_BASE_URL=https://api.dexscreener.com
OUTCOME_WINDOW_MINUTES=30
PRICE_POLL_SECONDS=8

# v0.4 exit engine
TAKE_PROFIT_ENABLED=true
TP_LADDER_JSON=[[1.50,0.25],[2.00,0.25],[3.00,0.25]]
TRAILING_STOP_PCT=20
TIME_STOP_MINUTES=30
REACTIVE_EXIT_DROP_PCT=25
CALL_OUTS_ENABLED=true
PUMPFUN_TAGLINE=BUILDING IN PUBLIC // SYNTHETICMIND

# Pump.fun native Callout automation
# Review Pump.fun Callout Terms before enabling automation.
PUMPFUN_CALLOUT_MODE=PLAYWRIGHT
PUMPFUN_CALLOUT_PROFILE_DIR=data/pumpfun-profile
PUMPFUN_CALLOUT_HEADLESS=true
PUMPFUN_CALLOUT_CREATE_URL=https://pump.fun/create
PUMPFUN_CALLOUT_ACCEPT_TERMS=false
PUMPFUN_CALLOUT_TIMEOUT_MS=30000
PUMPFUN_CALLOUT_TEMPLATE={tagline}\n\nBOUGHT ${symbol} | Position disclosed\nEntry: {amount_sol} SOL\nMint: {mint}\n{pump_url}
